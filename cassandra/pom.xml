<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<parent>
		<artifactId>metamodel</artifactId>
		<groupId>io.forenxics.metamodel</groupId>
		<version>5.3.4-forenxics.1</version>
	</parent>
	<modelVersion>4.0.0</modelVersion>
	<artifactId>metamodel-cassandra</artifactId>
	<name>MetaModel module for Apache Cassandra database</name>

	<properties>
		<cassandra.driver.latest.version>4.17.0</cassandra.driver.latest.version>
		<cassandraunit.latest.version>3.5.0.1</cassandraunit.latest.version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>io.forenxics.metamodel</groupId>
			<artifactId>metamodel-core</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- cassandra datastax driver -->
		<dependency>
			<!--
				The 4.x driver (com.datastax.oss:java-driver-core) replaces the
				legacy com.datastax.cassandra:cassandra-driver-core. It is a
				package-level migration, not a version bump: Cluster becomes
				CqlSession and the metadata types move to
				com.datastax.oss.driver.api.core.metadata.schema.
			-->
			<groupId>com.datastax.oss</groupId>
			<artifactId>java-driver-core</artifactId>
			<version>${cassandra.driver.latest.version}</version>
			<!--
				No netty exclusion here any more: the 3.x driver bundled a
				shaded netty, while the 4.x driver depends on netty 4.x
				outright (NoClassDefFoundError: io/netty/channel/
				DefaultEventLoopGroup without it).
			-->
		</dependency>
		<dependency>
			<!--
				The 4.x driver splits the query builder into its own artifact.
			-->
			<groupId>com.datastax.oss</groupId>
			<artifactId>java-driver-query-builder</artifactId>
			<version>${cassandra.driver.latest.version}</version>
		</dependency>
		<dependency>
			<groupId>commons-io</groupId>
			<artifactId>commons-io</artifactId>
		</dependency>
		<!-- test -->
		<dependency>
			<groupId>ch.qos.logback</groupId>
			<artifactId>logback-classic</artifactId>
			<version>1.2.13</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
